-- lsp-mcpp: the compiler-agnostic C++ modules language server (xim-pkgindex entry).
--
-- Rendered by packaging/scripts/xlings_artifacts.py for one release; the
-- rendered file goes to xim-pkgindex as pkgs/l/lsp-mcpp.lua. The server finds
-- clangd on PATH (llvm-tools) and the semantic kit in the xlings store
-- (lsp-mcpp-kit), which is what the two dependencies install.
package = {
    spec = "2",

    name = "lsp-mcpp",
    description = "Compiler-agnostic C++ modules language server: module navigation, completion and diagnostics for any compiler, with clangd",

    authors = {"mcpp community"},
    licenses = {"Apache-2.0"},
    repo = "https://github.com/mcpp-community/lsp-mcpp",

    type = "package",
    archs = {"x86_64", "aarch64"},
    status = "dev",
    categories = {"lsp", "cpp"},
    keywords = {"c++", "modules", "lsp", "clangd", "mcpp"},

    programs = { "lsp-mcpp" },
    xvm_enable = true,

    xpm = {
        source = "xlings-res",
        deps = { "xim:llvm-tools@@CLANGD_VERSION@", "xim:lsp-mcpp-kit@@KIT_VERSION@" },
        linux = {
            ["latest"] = { ref = "@VERSION@" },
            ["@VERSION@"] = { res = true, sha256 = { x86_64 = "@SHA256_LINUX_X86_64@" } },
        },
        macosx = {
            ["latest"] = { ref = "@VERSION@" },
            ["@VERSION@"] = { res = true, sha256 = { aarch64 = "@SHA256_MACOSX_AARCH64@" } },
        },
        windows = {
            ["latest"] = { ref = "@VERSION@" },
            ["@VERSION@"] = { res = true, sha256 = { x86_64 = "@SHA256_WINDOWS_X86_64@" } },
        },
    },
}

import("xim.libxpkg.pkginfo")
import("xim.libxpkg.xvm")

function install()
    -- The archive holds lsp-mcpp-<version>-<os>-<arch>/bin/lsp-mcpp[.exe].
    local root = pkginfo.install_file():replace(".tar.gz", "")
    os.tryrm(pkginfo.install_dir())
    os.trymv(root, pkginfo.install_dir())
    return true
end

function config()
    xvm.add("lsp-mcpp", { bindir = path.join(pkginfo.install_dir(), "bin") })
    return true
end

function uninstall()
    xvm.remove("lsp-mcpp")
    return true
end
