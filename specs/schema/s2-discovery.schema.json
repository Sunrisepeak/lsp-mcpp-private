{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mcpp-community/lsp-mcpp/specs/schema/s2-discovery/0.1.0",
  "title": "Build Database Discovery Protocol 0.1.0 (S2)",
  "description": "A value is either the request a consumer writes to the discovery command's standard input, or one message line the command writes to its standard output.",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/message" }
  ],
  "$defs": {
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "request": {
      "type": "object",
      "required": ["workspace", "profile-version"],
      "not": { "required": ["kind"] },
      "properties": {
        "workspace": { "type": "string", "minLength": 1 },
        "files": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "configuration": { "type": "string" },
        "profile-version": { "$ref": "#/$defs/semanticVersion" }
      }
    },
    "message": {
      "oneOf": [
        { "$ref": "#/$defs/progress" },
        { "$ref": "#/$defs/finished" },
        { "$ref": "#/$defs/error" }
      ]
    },
    "progress": {
      "type": "object",
      "required": ["kind", "message"],
      "properties": {
        "kind": { "const": "progress" },
        "message": { "type": "string" },
        "done": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "finished": {
      "type": "object",
      "required": ["kind", "database", "watch"],
      "properties": {
        "kind": { "const": "finished" },
        "database": { "type": "string", "minLength": 1 },
        "watch": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "profile-version": { "$ref": "#/$defs/semanticVersion" }
      }
    },
    "error": {
      "type": "object",
      "required": ["kind", "message"],
      "properties": {
        "kind": { "const": "error" },
        "message": { "type": "string" },
        "code": { "type": "string" }
      }
    }
  }
}
